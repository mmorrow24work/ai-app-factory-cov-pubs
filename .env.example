# Local environment for ai-app-factory-cov-pubs. Copy to `.env` (gitignored) and fill
# in real values — never commit `.env` itself.
#
# GitHub Actions secrets (CLAUDE_CODE_OAUTH_TOKEN, GH_PAT) that drive
# .github/workflows/claude.yml are configured separately as repo secrets,
# not here — this file is only for values the script itself reads at runtime.

# Example: an API key src/routes/+page.svelte needs to talk to an external service.
API_KEY=

# Example: runtime verbosity for src/routes/+page.svelte (e.g. debug, info, warn).
LOG_LEVEL=info
